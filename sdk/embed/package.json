{
  "name": "@majorcontext/harness-embed",
  "version": "0.0.0",
  "description": "Runs the harness WebAssembly module in a Worker and speaks ACP to it.",
  "type": "module",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./memoryfs": {
      "types": "./src/memoryfs.d.ts",
      "default": "./src/memoryfs.mjs"
    },
    "./shell": {
      "types": "./src/shell.d.ts",
      "default": "./src/shell.mjs"
    },
    "./webmcp": {
      "types": "./src/webmcp.d.ts",
      "default": "./src/webmcp.mjs"
    },
    "./zlib-stub": {
      "default": "./src/zlib-stub.mjs"
    }
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "license": "MIT",
  "peerDependencies": {
    "just-bash": ">=3.6.0 <4"
  },
  "peerDependenciesMeta": {
    "just-bash": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "just-bash": "3.6.0",
    "playwright": "1.64.0",
    "workerd": "1.20261026.1"
  }
}
